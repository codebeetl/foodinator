# Postgres connection string used by the app and by sqlx's compile-time query checks.
DATABASE_URL=postgres://foodinator:foodinator@localhost:5432/foodinator

# Address the web server binds to. Optional, defaults to 0.0.0.0:8080.
BIND_ADDR=0.0.0.0:8080

# Home Assistant integration - optional. Base URL of your HA instance (no
# trailing slash), a long-lived access token from your HA user profile's
# "Security" tab, and the entity ID of the Local Calendar integration to push
# events to (see docs/HA_SETUP.md for how to create one). Leave all three unset
# to run without HA syncing, or set some/all here as defaults that the
# Settings page can still override per-field at runtime.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-a-long-lived-access-token
HA_CALENDAR_ENTITY_ID=calendar.foodinator

# Google Calendar integration - optional. OAuth2 client ID/secret from a Google
# Cloud project (see README's Google Calendar integration section). Leave both
# unset to hide the "Connect to Google" button on /sync entirely. Which calendar
# to sync to is chosen via the in-app picker after connecting, not set here.
GCAL_CLIENT_ID=replace-with-a-google-oauth-client-id.apps.googleusercontent.com
GCAL_CLIENT_SECRET=replace-with-a-google-oauth-client-secret
# Override for the OAuth redirect URI - only needed when the browser completing
# the Google consent flow is on a different machine than the server (Google only
# allows "localhost" as a private-network redirect host). Point this at a tunnel
# URL (ngrok, Cloudflare Tunnel, etc.) ending in /sync/gcal/callback. Leave unset
# to derive the redirect URI from the incoming request.
GCAL_REDIRECT_URI=https://example.ngrok.io/sync/gcal/callback

# HTTP Basic auth credentials protecting the admin web UI and /admin/* endpoints.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-real-password

# IANA timezone the household lives in (e.g. Australia/Sydney, Europe/London).
# Used to convert meal-plan wall-clock times to UTC when pushing to Home Assistant.
APP_TZ=UTC

# Wall-display kiosk view - optional. When set, /display?token=<this value> shows
# a read-only, unauthenticated (no Basic Auth) week view meant for a tablet mounted
# on a wall/fridge. Leave unset to disable the route entirely.
DISPLAY_TOKEN=replace-with-a-random-token
