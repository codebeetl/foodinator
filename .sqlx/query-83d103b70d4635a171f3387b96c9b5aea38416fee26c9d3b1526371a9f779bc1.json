  "query": "INSERT INTO meal_plan_entries (entry_date, meal_id, notes, start_time_override, duration_minutes_override) VALUES ($1, $2, $3, $4, $5) ON CONFLICT (entry_date) DO UPDATE SET meal_id = EXCLUDED.meal_id, notes = EXCLUDED.notes, start_time_override = EXCLUDED.start_time_override, duration_minutes_override = EXCLUDED.duration_minutes_override, deleted_at = NULL, updated_at = now() RETURNING id, entry_date, meal_id, notes, start_time_override, duration_minutes_override, deleted_at, created_at, updated_at",
